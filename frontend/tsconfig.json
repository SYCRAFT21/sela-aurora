{
    "compilerOptions": {
        "target": "ES2022",
        "types": ["vite/client"],
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2022"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "src"
    ]
}